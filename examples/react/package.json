{
  "name": "silkify-react-example",
  "private": true,
  "type": "module",
  "scripts": {
    "silk": "node -e \"const fs=require('fs');fs.cpSync('../../src','src/silk',{recursive:true});fs.mkdirSync('public',{recursive:true});for(const f of ['pomegranate.webp','parrot.webp'])fs.copyFileSync('../images/'+f,'public/'+f)\"",
    "predev": "npm run silk",
    "prebuild": "npm run silk",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
